# RASP development configuration template.
# Copy to .env for local use. NEVER commit real credentials.

# Application
RASP_ENVIRONMENT=development
RASP_APP_NAME=RASP

# Policy configuration loaded at startup (startup fails closed on invalid policy).
RASP_POLICY_PATH=config/policies.example.yaml

# Model provider: "mock" is the only provider required for Milestone 1.
# "local" is planned for Milestone 4 and must not be assumed to work yet.
RASP_MODEL_PROVIDER=mock

# Agent loop limits (defense against unbounded tool-call loops).
RASP_MAX_AGENT_STEPS=3
RASP_MAX_REQUEST_BYTES=1000000
RASP_DEFAULT_TOOL_TIMEOUT_SECONDS=5.0

# Development-only identity mechanism.
# Requests are attributed via X-Dev-Principal / X-Dev-Permissions headers.
# This is NOT production authentication. See docs/THREAT_MODEL.md.
RASP_DEV_AUTH_ENABLED=true

# Audit privacy: when false (default) principal identifiers are stored as
# salted pseudonyms rather than raw values.
RASP_STORE_PRINCIPAL_IDS=false

# --- Milestone 2: PostgreSQL persistence (target store) ---
# "postgres" is the default and requires a reachable database before
# MUTATING actions execute (fail closed; read-only fallback is documented
# in docs/LIMITATIONS.md). "in_memory" is an explicit opt-out for demos
# and the documented test strategy — never a silent substitution.
RASP_PERSISTENCE=postgres
RASP_DATABASE_URL=postgresql+asyncpg://rasp:rasp@127.0.0.1:5433/rasp
# Bounded statements so a hung database cannot hang enforcement.
RASP_DATABASE_STATEMENT_TIMEOUT_MS=5000

# Isolated database used ONLY by `pytest -m postgres` (the fixture refuses
# to run destructive setup against a database whose name lacks "test").
# RASP_TEST_DATABASE_URL=postgresql+asyncpg://rasp:rasp@127.0.0.1:5433/rasp_test

# --- Milestone 3: structured logging ---
# Logs contain identifiers, decisions, and reason codes only — NEVER prompts,
# tool arguments, outputs, records, or credentials. Every line carries a
# request id correlated with the audit trail (echoed as X-Request-Id).
# Unknown level/format values REFUSE startup (no silent fallback).
RASP_LOG_LEVEL=INFO
RASP_LOG_FORMAT=json   # json | text
